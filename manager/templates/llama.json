{
  "template": "llama",
  "description": "Self-hosted LLM via llama.cpp (OpenAI-compatible)",
  "rootfs": "instances/openrouter-rootfs.ext4",
  "vcpus": 2,
  "mem_mib": 1024,
  "params": [
    {
      "key": "TRANSPORT",
      "label": "Transport",
      "type": "select",
      "options": [
        "signal",
        "web"
      ],
      "default": "web"
    },
    {
      "key": "SIGNAL_NUMBER",
      "label": "Signal number (bot)",
      "default": ""
    },
    {
      "key": "ALLOWED_SENDERS",
      "label": "Allowed number(s) — comma-separated, e.g. +4917…,+4915…",
      "default": ""
    },
    {
      "key": "LLAMA_ENDPOINT",
      "label": "llama.cpp endpoint (blank = from Settings tab)",
      "default": ""
    },
    {
      "key": "LLAMA_MODEL",
      "label": "Model name served by llama.cpp",
      "default": "local-model"
    },
    {
      "key": "AUTO_RESET_MIN",
      "label": "Auto-reset after idle (minutes, 0 = never) — a voice instance forgets the day's chatter, e.g. 30",
      "default": "0"
    },
    {
      "key": "SKILL_LEARN",
      "label": "Learn skills from experience (1 = after a long successful turn the agent distils a skill proposal, one extra model call; 0 = off)",
      "type": "select",
      "options": [
        "1",
        "0"
      ],
      "default": "1"
    },
    {
      "key": "HINDSIGHT_RETAIN",
      "label": "Keep turns in the second memory (Hindsight) — 1 = the user's messages and notes are retained; 0 = off (e.g. a high-volume voice agent). Only matters when HINDSIGHT_URL is set.",
      "type": "select",
      "options": [
        "1",
        "0"
      ],
      "default": "1"
    }
  ]
}
