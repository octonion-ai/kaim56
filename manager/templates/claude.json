{
  "template": "claude",
  "description": "Claude Code Agent",
  "rootfs": "instances/claude-rootfs.ext4",
  "vcpus": 2,
  "mem_mib": 1536,
  "params": [
    {
      "key": "TRANSPORT",
      "label": "Transport",
      "type": "select",
      "options": [
        "signal",
        "web",
        "mail"
      ],
      "default": "signal"
    },
    {
      "key": "SIGNAL_NUMBER",
      "label": "Signal number (bot)",
      "default": ""
    },
    {
      "key": "ALLOWED_SENDERS",
      "label": "Allowed number(s) — comma-separated, e.g. +4917…,+4915…",
      "default": ""
    },
    {
      "key": "ANTHROPIC_MODEL",
      "label": "Model (Claude Code)",
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "— account default —"
        },
        {
          "value": "opus",
          "label": "opus — latest Opus (alias)"
        },
        {
          "value": "sonnet",
          "label": "sonnet — latest Sonnet (alias)"
        },
        {
          "value": "haiku",
          "label": "haiku — latest Haiku (alias)"
        },
        {
          "value": "claude-opus-5",
          "label": "claude-opus-5"
        },
        {
          "value": "claude-sonnet-5",
          "label": "claude-sonnet-5"
        },
        {
          "value": "claude-haiku-4-5",
          "label": "claude-haiku-4-5"
        }
      ]
    },
    {
      "key": "ALLOW_ACTIONS",
      "label": "Allow actions",
      "type": "select",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "key": "AUTO_RESET_MIN",
      "label": "Auto-reset after idle (minutes, 0 = never) — a voice instance forgets the day's chatter, e.g. 30",
      "default": "0"
    },
    {
      "key": "SKILL_LEARN",
      "label": "Learn skills from experience (1 = after a long successful turn the agent distils a skill proposal, one extra model call; 0 = off)",
      "type": "select",
      "options": [
        "1",
        "0"
      ],
      "default": "1"
    },
    {
      "key": "HINDSIGHT_RETAIN",
      "label": "Keep turns in the second memory (Hindsight) — 1 = the user's messages and notes are retained; 0 = off (e.g. a high-volume voice agent). Only matters when HINDSIGHT_URL is set.",
      "type": "select",
      "options": [
        "1",
        "0"
      ],
      "default": "1"
    }
  ]
}
