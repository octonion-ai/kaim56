{
  "template": "openrouter",
  "description": "OpenRouter agent (tool calling)",
  "rootfs": "instances/openrouter-rootfs.ext4",
  "vcpus": 2,
  "mem_mib": 1024,
  "params": [
    {
      "key": "TRANSPORT",
      "label": "Transport",
      "type": "select",
      "options": [
        "signal",
        "web"
      ],
      "default": "signal"
    },
    {
      "key": "SIGNAL_NUMBER",
      "label": "Signal number (bot)",
      "default": ""
    },
    {
      "key": "ALLOWED_SENDERS",
      "label": "Allowed number(s) — comma-separated, e.g. +4917…,+4915…",
      "default": ""
    },
    {
      "key": "OPENROUTER_MODEL",
      "label": "Model (tool-capable, shortlist)",
      "type": "select",
      "source": "openrouter",
      "tools": true,
      "default": "google/gemini-2.5-flash",
      "relevant": true
    },
    {
      "key": "MCP_CONFIG",
      "label": "MCP servers JSON (optional)",
      "default": ""
    },
    {
      "key": "AUTO_RESET_MIN",
      "label": "Auto-reset after idle (minutes, 0 = never) — a voice instance forgets the day's chatter, e.g. 30",
      "default": "0"
    },
    {
      "key": "SKILL_LEARN",
      "label": "Learn skills from experience (1 = after a long successful turn the agent distils a skill proposal, one extra model call; 0 = off)",
      "type": "select",
      "options": [
        "1",
        "0"
      ],
      "default": "1"
    }
  ]
}
